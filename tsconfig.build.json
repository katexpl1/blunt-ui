{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationDir": "./dist"
  },
  "include": [
    "src/index.ts",
    "src/components",
    "src/consts.ts",
    "src/styles",
    "src/themes",
    "src/styled.d.ts"
  ],
  "exclude": ["src/**/*.styles.ts"]
}
